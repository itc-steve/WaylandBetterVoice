[Unit]
Description=WaylandBetterVoice daemon
After=pipewire.service
# WAYLAND_DISPLAY only lands in the systemd user env once the compositor is up.
# Starting earlier leaves wtype with no Wayland socket (text goes to clipboard).
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
# Preloads Whisper model into VRAM at session start for fast transcription.
ExecStart=/usr/bin/wbv daemon --foreground
Restart=on-failure
# Finalizing a long meeting on shutdown (transcript + wav mix) can outlast the
# 10s default and get SIGKILLed mid-write.
TimeoutStopSec=120
# No PrivateDevices or ProtectHome: PipeWire and CUDA require device and user-data access.

[Install]
WantedBy=graphical-session.target
