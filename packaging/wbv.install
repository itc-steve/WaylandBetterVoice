post_install() {
  cat <<'EOF'
WaylandBetterVoice installed.

Next steps (run as your normal desktop user):
  1. Download model: wbv model download large-v3
  2. Enable service: systemctl --user enable --now waylandbettervoice.service
  3. Copy Noctalia v5 plugin (user-owned):
     plugin_dir="${XDG_DATA_HOME:-$HOME/.local/share}/noctalia/plugins/waylandbettervoice"
     mkdir -p "$plugin_dir" && cp -r /usr/share/waylandbettervoice/noctalia-plugin/. "$plugin_dir/"
     noctalia msg config-reload
     noctalia msg plugins enable itc-steve/waylandbettervoice
     Add bar widget type: itc-steve/waylandbettervoice:mic
     Archive any old ~/.config/noctalia/plugins/waylandbettervoice v4 copy separately.
  4. Copy /usr/share/waylandbettervoice/niri-keybinds.kdl to ~/.config/niri/cfg/waylandbettervoice.kdl,
     then add include "./cfg/waylandbettervoice.kdl" to your niri config.
EOF
}
