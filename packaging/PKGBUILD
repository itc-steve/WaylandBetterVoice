# Local-only package: source=() builds directly from this repository's parent directory.
pkgname=waylandbettervoice
pkgver=1.4.1
pkgrel=1
pkgdesc="Local Wayland voice dictation and meeting transcription"
arch=('any')
url="https://github.com/itc-steve/WaylandBetterVoice"
license=('MIT')
depends=(
  'python'
  'python-numpy'
  'python-pywhispercpp'
  'wtype'
  'wl-clipboard'
  'pipewire'
  'libpulse'
  'libnotify'
)
makedepends=(
  'python-build'
  'python-installer'
  'python-setuptools'
  'python-wheel'
)
optdepends=(
  'python-sherpa-onnx: meeting speaker diarization'
  'noctalia: Noctalia v5 bar, panel and recording indicator plugin'
  'ydotool: inject_method=ydotool, needed to type into Electron apps (Termius, VS Code)'
)
install='wbv.install'
source=()
sha256sums=()

_repo_root="${startdir}/.."

build() {
  cd "${_repo_root}"
  python -m build --wheel --no-isolation
}

check() {
  cd "${_repo_root}"
  python -m waylandbettervoice.selftest
  if command -v lua >/dev/null; then
    lua noctalia-plugin/test_plugin.lua
  fi
  if command -v noctalia >/dev/null; then
    noctalia plugins lint noctalia-plugin/waylandbettervoice
  fi
}

package() {
  cd "${_repo_root}"
  python -m installer --destdir="${pkgdir}" "dist/${pkgname}-${pkgver}-py3-none-any.whl"

  install -Dm644 packaging/waylandbettervoice.service \
    "${pkgdir}/usr/lib/systemd/user/waylandbettervoice.service"
  install -Dm644 packaging/niri-keybinds.kdl \
    "${pkgdir}/usr/share/waylandbettervoice/niri-keybinds.kdl"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
  cp -a noctalia-plugin/waylandbettervoice \
    "${pkgdir}/usr/share/waylandbettervoice/noctalia-plugin"
}
