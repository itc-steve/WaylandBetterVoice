# Maintainer: WaylandBetterVoice

pkgname=python-pywhispercpp-cuda
pkgver=1.4.0
pkgrel=12
pkgdesc="Python bindings for whisper.cpp with CUDA support (NVIDIA GPU)"
arch=('x86_64')
url="https://github.com/Absadiki/pywhispercpp"
license=('MIT')
options=('!strip')
depends=(
  'python'
  'python-numpy'
  'python-requests'
  'python-tqdm'
  'python-platformdirs'
  'cuda'
)
makedepends=(
  'cmake'
  'ninja'
  'python-build'
  'python-installer'
  'python-wheel'
  'python-setuptools'
  'python-setuptools-scm'
  'git'
  'cuda'
  'patchelf'
)
optdepends=(
  'python-sounddevice: run pywhispercpp examples that capture audio'
  'python-webrtcvad: run VAD-based examples'
  'python-pyqt5: run GUI example'
)
provides=("python-pywhispercpp=${pkgver}")
conflicts=('python-pywhispercpp' 'python-pywhispercpp-cpu' 'python-pywhispercpp-rocm')
source=("git+https://github.com/Absadiki/pywhispercpp.git#commit=4ab96165f84e8eb579077dfc3d0476fa5606affe")
sha256sums=('SKIP')

prepare() {
  cd "$srcdir/pywhispercpp"
  git submodule update --init --recursive
}

build() {
  cd "$srcdir/pywhispercpp"
  # Set CUDA environment variables for GPU acceleration
  export GGML_CUDA=ON
  export PYTHONNOUSERSITE=1
  export PATH="/opt/cuda/bin:$PATH"
  export CUDACXX="${CUDACXX:-/opt/cuda/bin/nvcc}"

  # This local package targets the RTX PRO 6000 Blackwell (compute capability 12.0).
  local cuda_archs="120"

  # Force CMake to use system Python; FindPython still searches PATH without this.
  export CMAKE_ARGS="-DPYTHON_EXECUTABLE=/usr/bin/python -DPython3_EXECUTABLE=/usr/bin/python -DCMAKE_CUDA_ARCHITECTURES=$cuda_archs"
  python -m build --wheel --no-isolation
}

package() {
  cd "$srcdir/pywhispercpp"
  python -m installer --destdir="$pkgdir" dist/*.whl

  local _python_version
  _python_version=$(python -c 'import sys; print(".".join(map(str, sys.version_info[:2])))')
  local _site_packages="$pkgdir/usr/lib/python$_python_version/site-packages"
  local _libs_dir="$_site_packages/pywhispercpp.libs"

  # Use the system NVIDIA driver, never a wheel-bundled libcuda.
  find "$_site_packages" -name 'libcuda*.so*' \( -type f -o -type l \) ! -name 'libcudart*' -delete

  local _binary_sos=("$_site_packages"/_pywhispercpp.cpython-*-linux-gnu.so)
  [[ -f "${_binary_sos[0]}" ]] || {
    error "pywhispercpp extension not found"
    return 1
  }

  local _elfs=("${_binary_sos[@]}")
  if [[ -d "$_libs_dir" ]]; then
    while IFS= read -r -d '' f; do
      _elfs+=("$f")
    done < <(find "$_libs_dir" -type f \( -name '*.so' -o -name '*.so.*' \) -print0)
  fi

  local f needed needed_list
  for f in "${_elfs[@]}"; do
    if ! needed_list=$(patchelf --print-needed "$f"); then
      error "cannot inspect ELF dependencies: $f"
      return 1
    fi
    for needed in $needed_list; do
      case "$needed" in
        libcuda-*.so*)
          patchelf --replace-needed "$needed" libcuda.so.1 "$f" || return 1
          ;;
      esac
    done

    if ! needed_list=$(patchelf --print-needed "$f"); then
      error "cannot validate ELF dependencies: $f"
      return 1
    fi
    case "$needed_list" in
      *libcuda-*.so*)
        error "private libcuda dependency remains: $f"
        return 1
        ;;
    esac
  done

  local bundled_driver
  bundled_driver=$(find "$_site_packages" -name 'libcuda*.so*' \( -type f -o -type l \) ! -name 'libcudart*' -print -quit) || return 1
  if [[ -n "$bundled_driver" ]]; then
    error "bundled libcuda remains in package: $bundled_driver"
    return 1
  fi
}
